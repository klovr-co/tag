# Copy this file to .env. Do not commit .env or its tokens.

export MFS_URL="http://127.0.0.1:13619"
export MFS_TOKEN="replace-with-your-mfs-token"
export MFS_ALLOWED_SCOPES="file://local/path/to/your/workspace"

# Choose one installed local CLI backend: codex or claude.
export OPENTAG_BACKEND="codex"
export OPENTAG_WORKDIR="/path/to/your/workspace"
export OPENTAG_TIMEOUT_SECONDS=420
export OPENTAG_BACKEND_ATTEMPTS=3

# Optional local tools, such as `gws`, use their own installation, authentication,
# and OAuth configuration. Open Tag does not maintain separate tool allowlists.

# Choose the chat transport started by OpenTag Control: slack, zulip, or both.
export OPENTAG_TRANSPORT="both"

# Zulip bot credentials. Create a Generic bot named OpenCodex/OpenClaude,
# download its zuliprc file, and keep that file outside this repository.
export ZULIP_CONFIG_FILE="/path/to/opentag-zuliprc"

# Select OpenTag's small one-shot adapter or the pinned ZulipMCP persistent-topic
# canary. ZulipMCP keeps native available as an immediate rollback.
export OPENTAG_ZULIP_ENGINE="native"
export OPENTAG_ZULIPMCP_CODEX_PERMISSION_MODE="workspace-write"
export OPENTAG_ZULIPMCP_MAX_SESSIONS=1
export OPENTAG_ZULIPMCP_IDLE_HOURS=0.5

# ZulipMCP defaults to no private-stream reads. List explicitly permitted private
# streams here. An empty write list retains upstream's allow-all write default;
# set an explicit list for a constrained canary.
export BOT_ALLOWED_PRIVATE_STREAMS=""
export BOT_ALLOWED_WRITE_STREAMS=""

# Optional: Automatically grant Hover Bot access to every private Zulip stream
# where it is mentioned, including that stream's prior history. This requires a
# separate Zulip organization administrator's zuliprc; never use the bot's file.
export ZULIP_AUTO_GRANT_PRIVATE_HISTORY="false"
export ZULIP_ADMIN_CONFIG_FILE="/path/to/zulip-admin.zuliprc"

# Slack app credentials. Create these in your own Slack workspace.
export SLACK_APP_TOKEN="xapp-replace-me"
export SLACK_BOT_TOKEN="xoxb-replace-me"

# Used by preflight checks; the bridge can respond in any channel where the bot
# is a member.
export SLACK_CHANNEL_ID="C0123456789"
